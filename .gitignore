# ----------------------------
target/
*.class
*.jar
*.war
*.ear

# Maven Wrapper Logs
.mvn/wrapper/maven-wrapper.jar

# ----------------------------
# React
# ----------------------------
node_modules/
build/

# Yarn / NPM
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ----------------------------
# Environment Variables
# ----------------------------
.env
.env.*
!.env.example

# ----------------------------
# Build / Cache
# ----------------------------
.cache/
coverage/

# ----------------------------
# Logs
# ----------------------------
logs/
*.log

# ----------------------------
